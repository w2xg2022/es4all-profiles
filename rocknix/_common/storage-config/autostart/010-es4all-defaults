#!/bin/sh
# es4all: 开机时、★在 ES 启动之前★套用两件事 —— 音量预设与音源输出。
#
# ROCKNIX 会依序执行 /storage/.config/autostart/ 底下的档案, 时机在 ES 之前,
# 这正是这两件事必须待在这里、而不是待在 apply.sh 的原因:
#
#   ① 音量预设
#      apply.sh 是【ES 起来之后】由 ES 自己呼叫的, 那时 ES 早就把旧值读进记忆体了 ——
#      改了档案, 选单显示的仍是旧值, 而且 ES 结束时会把记忆体那份写回去, 反手盖掉。
#      实机 2026-08-04: apply.sh 明明写了 audio.volume=80, 使用者看到的还是 60。
#      放在这里就没有这个时序问题: 档案先改好, ES 起来读到的就是新值。
#
#   ② 音源输出(HDMI / AV)
#      ★PipeWire 的 default sink 每次开机都会重置★, 所以「选过一次就永远是那个」
#      不成立 —— 必须每次开机重新套用一次, 否则设定只在当次有效。
#
# 幂等: 音量只在【标记档内容与建议值不同】时才写(使用者之后自己调的不会被覆盖);
#       音源则是每次都套用(它本来就该跟着设定走)。
# 失败一律不致命: 这是加值功能, 绝不能因为它让开机卡住。

CFG=/storage/.config/system/configs/system.cfg
ES4ALL_DIR=/storage/.config/es4all

log() { echo "es4all-defaults: $*"; }

conf_get() { sed -n "s/^$1=//p" "${CFG}" 2>/dev/null | head -1; }
conf_set() {
	[ -f "${CFG}" ] || : > "${CFG}"
	if grep -q "^$1=" "${CFG}" 2>/dev/null; then
		sed -i "s|^$1=.*|$1=$2|" "${CFG}"
	else
		echo "$1=$2" >> "${CFG}"
	fi
}

# ---------------------------------------------------------------------------
# ① 音量预设
# ---------------------------------------------------------------------------
# 出厂 fallback 是 60(见 /usr/lib/autostart/common/050-audio 里写死的值), 对电视盒偏小 ——
# 它们透过 HDMI 推外接喇叭/电视, 与 ROCKNIX 常见的掌机不同。
# ★而且那个 60 首次开机就会被写回 system.cfg★, 从此变成「使用者的值」,
# 固件端再改预设也追不回来, 所以既有机器只能从这里改。
VOL_WANT=80
VOL_STAMP="${ES4ALL_DIR}/.audio-volume-applied"
if [ "$(cat "${VOL_STAMP}" 2>/dev/null)" != "${VOL_WANT}" ]; then
	mkdir -p "${ES4ALL_DIR}"
	conf_set audio.volume "${VOL_WANT}"
	echo "${VOL_WANT}" > "${VOL_STAMP}"
	log "音量预设 -> ${VOL_WANT}"
fi

# ---------------------------------------------------------------------------
# ② 音源输出
# ---------------------------------------------------------------------------
# 无参数呼叫 = 读 system.audiooutput 重新套用(脚本自己有这条路径)。
# ★必须每次开机跑★: PipeWire 的 default sink 不持久, 开机一律回到它自己挑的那个。
AUDIO_OUT="$(conf_get system.audiooutput)"
if [ -n "${AUDIO_OUT}" ] && [ -x "${ES4ALL_DIR}/bin/setaudio.sh" ]; then
	sh "${ES4ALL_DIR}/bin/setaudio.sh" >/dev/null 2>&1 && \
		log "音源输出重新套用 -> ${AUDIO_OUT}" || \
		log "注意: 音源输出套用失败(不影响开机)"
fi

# ---------------------------------------------------------------------------
# ③ 把键位精灵的结果盖回 /storage/joypads
# ---------------------------------------------------------------------------
# ★固件里的 002-es4all-glue 每次开机都会无条件把一份【写死的】joypad 档复制到
#   /tmp/joypads，把使用者自己跑精灵的结果整个盖掉★(2026-08-04 实机坐实:
#   重开机后 /storage/joypads 那份的 md5 变回出厂值, RA 的组合键跟着全没了)。
#
#   那支膠水是我们自己早期埋的: 当时还没有「精灵 -> 转换器 -> joypad 档」这条链,
#   只能在固件里塞一份对齐好的。链通了之后它就从【补救】变成【破坏】——
#   与 A 版那份 A/B 互换 remap 同一种病: 旧补丁在新机制上线后没有撤掉。
#
#   固件侧已经把那段删掉, 但固件要重编才生效; 这里是不必重编的即时解药,
#   而且顺序天生正确 —— /usr/bin/autostart 先跑 /usr/lib/autostart/common/*(膠水),
#   再跑 /storage/.config/autostart/*(本档), 所以我们一定盖得回去。
#
#   备份来源: 钩子(10-inputconfig.sh)每次转换完会顺手存一份到这里。
#   没有备份就什么都不做 —— 没跑过精灵的机器本来就该用发行版那份。
JP_SAVE="${ES4ALL_DIR}/joypads"
if [ -d "${JP_SAVE}" ] && [ -d /storage/joypads ]; then
	for f in "${JP_SAVE}"/*.cfg; do
		[ -f "${f}" ] || continue
		if ! cmp -s "${f}" "/storage/joypads/$(basename "${f}")"; then
			cp -f "${f}" "/storage/joypads/$(basename "${f}")" && \
				log "还原键位档 $(basename "${f}")(被固件膠水盖掉了)"
		fi
	done
fi

# ---------------------------------------------------------------------------
# ★PPSSPP 那边【不在这里】处理★(2026-08-04 一度做错, 留个记号)
#   我曾在这里另外 bind-mount 一份补好的 start_ppsspp.sh。但 profiles 本来就有
#   override 机制(es4all/override/ 由 selfmount.sh 挂到 /usr/bin), 於是同一个档
#   ★叠了两层★, 而生效的是后挂的那层 —— 里面没有我的修改。
#   表现是「改了完全没作用」, 偏偏两层都存在、各自看起来都对, 极难看出来
#   (要 mount | grep 才会发现同一个路径出现两次)。
#   ★同一个目标只能有一个机制★: PPSSPP 的修改一律进
#   rocknix/_common/storage-config/es4all/override/start_ppsspp.sh。

# ---------------------------------------------------------------------------
# ④ PSP(PPSSPP)预设走 Vulkan
# ---------------------------------------------------------------------------
# ★不设的话拿到的不是「预设值」而是一个坏值★: start_ppsspp.sh 只认 opengl/vulkan,
# 其余一律走 else 分支, 而那个分支写进 ppsspp.ini 的是【字面的 @GRENDERER@】——
# 上游自己的 bug, 於是 GraphicsBackend 根本不是合法值。
# RK3566 的 Mali-G52 走 Vulkan 比 GL 稳, 直接把它定为预设。
# 幂等且只补【没设过】的: 使用者后来自己在选单改 opengl 不会被抢回来。
if [ -f "${CFG}" ] && ! grep -q '^psp.graphics_backend=' "${CFG}"; then
	conf_set psp.graphics_backend vulkan
	log "PSP 图形后端预设 -> vulkan"
fi

# ---------------------------------------------------------------------------
# ⑤ 修正固件/发行版的 setsettings.sh(两处, 用同一份 bind-mount 顶上)
# ---------------------------------------------------------------------------
#   ⑤-1 撤掉我们早期加的 A/B 位置对齐 remap(旧补丁, 见下)
#   ⑤-2 让「热键 + 印刷 X/Y」不要被发行版改写(2026-08-16 实机)
#
# ⑤-2 的来龙去脉:
#   使用者设的是 SELECT+X 叫选单、SELECT+Y 显示 FPS, 实机却【正好相反】。
#   我们产的 joypad 档是对的(menu=2=印刷X, fps=3=印刷Y, 照精灵按下去那颗),
#   问题出在 ROCKNIX 的 setsettings.sh: system.autohotkeys=1 时它每次启动游戏
#   都会 source 那份 joypad 档、然后【用自己的算法覆写】进 retroarch.cfg:
#       input_menu_toggle_btn = "${input_x_btn}"
#       input_fps_toggle_btn  = "${input_y_btn}"
#   而我们的 autoconfig 是【方位对齐】的 —— RetroPad X = 北 = 印刷 Y、
#   RetroPad Y = 西 = 印刷 X, 于是这两行一写就把印刷 X/Y 对调了。
#   (铁证: retroarch.cfg 里 fps=2 menu=3, 与我们那份 menu=2 fps=3 正好互换。)
#
#   修法是让它【优先用 joypad 档里已经有的值】, 没有才回到原本的算法:
#       ${input_menu_toggle_btn:-${input_x_btn}}
#   这样只有我们产的档(带热键行)会走新路径, 发行版出厂那些档行为完全不变。
#   ★不改成「按 InvertButtons 取反」★: 那等于把同一条规则再抄一份到这里,
#   而精灵的结果本来就已经写在 joypad 档里了, 直接用它才是单一真相。
# ---------------------------------------------------------------------------
# ★又是「旧补丁没随新机制撤掉」★(2026-08-04 实机: 游戏内 A/B 整个翻转)
#   固件的 setsettings.sh 有我们加的 set_position_remap, 每次启动游戏都往
#   /storage/remappings/<核心>/<核心>.rmp 写 input_player1_btn_a="0" / btn_b="8"。
#   当年那是必要的: joypad autoconfig 还是出厂那份(A 绑在南), 得靠这层翻转补位。
#   现在精灵产的那份【本身就按位置对齐】(input_a_btn=东), 两层一叠就翻回去了。
#
#   固件侧已经删掉, 但要重编才生效; 这里用 bind-mount 挂一份修好的顶上,
#   而且★自我失效★—— 固件更新后没有那个标记就整段跳过, 不会变成下一个旧补丁。
SS=/usr/bin/setsettings.sh
SS_FIX="${ES4ALL_DIR}/bin/setsettings.sh"
SS_WHY=""
mkdir -p "$(dirname "${SS_FIX}")"
cp -f "${SS}" "${SS_FIX}" 2>/dev/null

# ⑤-1 ★旧补丁没随新机制撤掉★(2026-08-04 实机: 游戏内 A/B 整个翻转)
#   固件的 setsettings.sh 有我们加的 set_position_remap, 每次启动游戏都往
#   /storage/remappings/<核心>/<核心>.rmp 写 input_player1_btn_a="0" / btn_b="8"。
#   当年那是必要的: joypad autoconfig 还是出厂那份(A 绑在南), 得靠这层翻转补位。
#   现在精灵产的那份【本身就按位置对齐】(input_a_btn=东), 两层一叠就翻回去了。
#   ★自我失效★: 固件更新后没有那个标记就跳过, 不会变成下一个旧补丁。
if grep -q 'es4all-position-align' "${SS_FIX}" 2>/dev/null; then
	# ★不能整行删★: 那三行 echo 分别待在 if 与 { } 里面, 删光就剩空的区块,
	# bash 直接 syntax error(踩过一次: 「修正版语法检查未过」)。
	# 把第一行换成 no-op(:) 再删另外两行, 结构就还在。
	# 原本那句 sed -i 刻意【保留】—— 它正好会把 .rmp 里旧的残留行扫掉。
	sed -i "s|echo '# es4all-position-align'|:|; \
	        /echo 'input_player1_btn_a = \"0\"'/d; \
	        /echo 'input_player1_btn_b = \"8\"'/d" "${SS_FIX}"
	SS_WHY="${SS_WHY}移除 A/B 翻转 remap; "
fi

# ⑤-2 热键的选单/FPS 改成【优先用 joypad 档里的值】(理由见上面那段)
if grep -q 'input_menu_toggle_btn = "${input_x_btn}"' "${SS_FIX}" 2>/dev/null; then
	sed -i 's|input_menu_toggle_btn = "${input_x_btn}"|input_menu_toggle_btn = "${input_menu_toggle_btn:-${input_x_btn}}"|; \
	        s|input_fps_toggle_btn = "${input_y_btn}"|input_fps_toggle_btn = "${input_fps_toggle_btn:-${input_y_btn}}"|' "${SS_FIX}"
	SS_WHY="${SS_WHY}选单/FPS 热键改用 joypad 档的值; "
fi

if [ -n "${SS_WHY}" ]; then
	chmod +x "${SS_FIX}"
	# ★语法检查一定要用 bash★: setsettings.sh 满是 function/local 这类 bashism,
	# 拿 ash 检查会直接判失败, 结果永远挂不上去(而且看起来像「修正版有问题」)。
	if bash -n "${SS_FIX}" 2>/dev/null; then
		mount --bind "${SS_FIX}" "${SS}" && log "已挂上修正版 setsettings.sh(${SS_WHY})"
	else
		log "注意: 修正版 setsettings.sh 语法检查未过, 维持原样"
	fi
else
	rm -f "${SS_FIX}"
fi
# 已经写进 .rmp 的那两行也要清掉 —— 它是累积写入的, 不清就一直在。
for r in /storage/remappings/*/*.rmp; do
	[ -f "${r}" ] || continue
	sed -i '/# es4all-position-align/d; /^input_player1_btn_a = "0"$/d; /^input_player1_btn_b = "8"$/d' "${r}"
done

# ---------------------------------------------------------------------------
# ④ 关掉 RetroArch 的「再按一次退出」确认
# ---------------------------------------------------------------------------
# 热键+退出键本来就是【组合键】, 已经不可能误触, 再要求按第二次只是多一道墙:
# 画面正中跳一个白框问「再按一次退出...」, 对电视盒使用者更像是当机。
#
# ★为什么要放在这里每次开机矫正★: 出厂模板 /usr/config/retroarch/retroarch.cfg
# 写的是 true, 那个档在唯读的固件里改不了。/storage 那份平常是持久的,
# 但只要它哪天被重建(还原出厂、换固件、手动删档), 白框就会无声无息回来。
# 每次开机对一次最省事, 而且幂等 —— 值已经对了就不写。
RA_CFG=/storage/.config/retroarch/retroarch.cfg

# 同一个理由(出厂模板在唯读固件里)顺手矫正的几项。
ra_set() {   # $1=键 $2=值; 幂等, 值已经对了就不写
	[ -f "${RA_CFG}" ] || return 0
	grep -q "^$1 = \"$2\"" "${RA_CFG}" && return 0
	if grep -q "^$1" "${RA_CFG}"; then
		sed -i "s|^$1.*|$1 = \"$2\"|" "${RA_CFG}"
	else
		echo "$1 = \"$2\"" >> "${RA_CFG}"
	fi
	log "RetroArch $1 -> $2"
}

# ---------------------------------------------------------------------------
# ⑥ 确保 PPSSPP 那份 SDL 对照表还在
# ---------------------------------------------------------------------------
# ppsspp 二进位里写死了一条路径, 启动时自己再载入一次 db(覆盖环境变数给的那份):
#     /storage/.config/SDL-GameControllerDB/gamecontrollerdb.txt
# 出厂它是指向唯读固件的【符号连结】, 键位精灵跑完时会被实体化成真档并追加我们那行。
# 这里只是保险: 万一它被还原成符号连结(换固件、还原出厂), 开机时补回去,
# 否则 PSP 的 SELECT/START 会无声无息变回 SDL 内建的排法。
SYS_DB=/storage/.config/SDL-GameControllerDB/gamecontrollerdb.txt
OUR_DB="${ES4ALL_DIR}/gamecontrollerdb.txt"
if [ -f "${OUR_DB}" ] && [ -e "${SYS_DB}" ] && ! grep -q '^# es4all-mapping$' "${SYS_DB}"; then
	if [ -L "${SYS_DB}" ]; then
		_s="$(readlink -f "${SYS_DB}")"; rm -f "${SYS_DB}"; cp -f "${_s}" "${SYS_DB}"
	fi
	{ echo '# es4all-mapping'; cat "${OUR_DB}"; } >> "${SYS_DB}"
	log "补回 PPSSPP 用的 SDL 对照行"
fi

ra_set quit_press_twice false
# 选单字体: 出厂 0.86 在电视上偏大(掌机的预设值直接搬过来的), 电视盒坐得远、
# 解析度也高, 缩到 0.65 一页看得到的项目才够多。
ra_set menu_scale_factor 0.650000

# ---------------------------------------------------------------------------
# ⑦ RA 选单的「确认/取消」要落在【印刷 A】那颗
# ---------------------------------------------------------------------------
# ★ROCKNIX 侧一直漏了这一项★(2026-08-16 实机: A 在南、X 在西的手柄, 在 RA 选单里
#   按印刷 A 是【返回】、按印刷 B 才是【确认】, 使用者的说法是「AB 对调了」)。
#
# 成因与 EmuELEC 侧同一个(见 emuelec/.../setsettings.sh 的 menu_swap 注解):
#   RA 选单的确认键 = (autoconfig 把 RetroPad A 绑到哪颗) × (swap)。
#   我们的 autoconfig 是【方位对齐】的, RetroPad A 恒等于【东】那颗, 于是:
#     Xbox 式 (InvertButtons=false, 印刷 A 在南) -> 确认落 RetroPad B -> swap=true
#     任天堂式(InvertButtons=true , 印刷 A 在东) -> 确认落 RetroPad A -> swap=false
#   => swap = !InvertButtons  ★取反, 不是直接等于★
#
# E 侧是在 setsettings.sh(每次启动游戏)里写的; R 的 setsettings.sh 不管这个键,
# 也不会把它删掉(它只删自己管的那批), 所以放在开机写一次就够、而且不会被洗掉。
ES_SETTINGS=/storage/.config/emulationstation/es_settings.cfg
if [ -f "${ES_SETTINGS}" ] && grep -q '"InvertButtons" value="true"' "${ES_SETTINGS}"; then
	ra_set menu_swap_ok_cancel_buttons false
else
	ra_set menu_swap_ok_cancel_buttons true
fi

exit 0
