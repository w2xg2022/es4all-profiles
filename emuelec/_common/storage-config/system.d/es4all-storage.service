# es4all: 内外部盘聚合(EmuELEC 版)。
#
# ★顺序: 必须在 ES 之前、而且在发行版把 ROM 挂好之後★
#   EmuELEC 开机时由 /usr/sbin/eemount(C 程式, 早期 init)把 EEROMS 挂到 /storage/roms。
#   本服务接手那个既成结果: 把它 move 到 /storage/games-internal, 再叠成 overlay。
#   所以 After 要挂在 storage.mount 之後、Before 要在 emustation.service 之前。
#
# ★预设不启用任何动作★: 脚本第一件事就是看 system.merged.storage,
#   不是 1 就直接退出。所以即使这个 unit 被 enable, 没开关的机器行为完全不变。
#
# 与 selfmount 一样放 /storage/.config/system.d(systemd UnitPath 之一, 可写且持久),
# 整包由 es4all-profiles 下发, 不必动只读的 /usr。
[Unit]
Description=es4all storage aggregation (merge internal and external ROM drives)
Before=emustation.service
After=storage.mount
RequiresMountsFor=/storage

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/storage/.config/es4all/bin/es4all-storage.sh

[Install]
WantedBy=emuelec.target
